# =======================================================
# .env.example — copy to .env and fill in your values
# =======================================================

# ── Which broker to use ──────────────────────────────────
# Options: kite | shoonya
BROKER=shoonya

# ── Zerodha Kite Connect (₹2,360/month) ─────────────────
# Get from: https://developers.kite.trade/apps
KITE_API_KEY=
KITE_API_SECRET=
# Auto-written by: python3 auth/token_manager.py
KITE_ACCESS_TOKEN=

# ── Shoonya / Finvasia (FREE) ────────────────────────────
# Open a FREE account at: https://finvasia.com
# Then run: python3 auth/shoonya_login.py
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_SECRET=

# ── Upstox Sandbox Developer API ─────────────────────────
# Get credentials from: https://developer.upstox.com
UPSTOX_API_KEY=5d237a8c-ac42-412b-9ec4-c60f21a495cd
UPSTOX_API_SECRET=bcg94q6w6a
UPSTOX_ACCESS_TOKEN=
UPSTOX_SANDBOX=true
PAPER_BROKER=upstox_sandbox

# ── OpenRouter AI Intelligence ───────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── ElevenLabs Voice Narration ───────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ── Creatomate Automated Video Renderer ──────────────────
CREATOMATE_API_KEY=
CREATOMATE_TEMPLATE_ID=

# ── YouTube Data API v3 Video Publication ────────────────
YOUTUBE_API_CREDENTIALS=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PUBLISH_MODE=private

# ── Supabase Authoritative Cloud Ledger (PostgreSQL) ─────
# Get from your project dashboard: https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── GitHub Actions Cloud Dispatch (Netlify -> GitHub) ────
# Required for Netlify Scheduled Function to trigger GitHub Actions workflow
GH_DISPATCH_TOKEN=
GITHUB_REPOSITORY=samudralasrikanth/algo-trader

# ── Production Environment Lock ──────────────────────────
# Must remain strictly PAPER for current deployment
NEXUS_ENVIRONMENT=PAPER


