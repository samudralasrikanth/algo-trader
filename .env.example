# =======================================================
# .env.example — copy to .env and fill in your values
# =======================================================

# ── Which broker to use ──────────────────────────────────
# Options: kite | shoonya
BROKER=shoonya

# ── Zerodha Kite Connect (₹2,360/month) ─────────────────
# Get from: https://developers.kite.trade/apps
KITE_API_KEY=
KITE_API_SECRET=
# Auto-written by: python3 auth/token_manager.py
KITE_ACCESS_TOKEN=

# ── Shoonya / Finvasia (FREE) ────────────────────────────
# Open a FREE account at: https://finvasia.com
# Then run: python3 auth/shoonya_login.py
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_SECRET=

# ── Upstox Sandbox Developer API ─────────────────────────
# Get credentials from: https://developer.upstox.com
UPSTOX_API_KEY=5d237a8c-ac42-412b-9ec4-c60f21a495cd
UPSTOX_API_SECRET=bcg94q6w6a
UPSTOX_SANDBOX=true
PAPER_BROKER=upstox_sandbox

